# Copy this file to .env.local and fill in real values. Never commit real values.
# Only this example file is tracked by git (see .gitignore).

# Postgres connection string used by the order API (@vercel/postgres / Neon)
DATABASE_URL=

# Resend API key for order emails
RESEND_API_KEY=

# Vercel Blob read/write token for order file uploads (@vercel/blob)
BLOB_READ_WRITE_TOKEN=
