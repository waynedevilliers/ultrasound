# Copy this file to .env.local and fill in real values. Never commit real values.
# Only this example file is tracked by git (see .gitignore).

# Postgres connection string used by the order API (@vercel/postgres / Neon)
DATABASE_URL=

# Resend API key for order emails
RESEND_API_KEY=

# Vercel Blob read/write token for order file uploads (@vercel/blob)
BLOB_READ_WRITE_TOKEN=

# Signs the links in order emails (any long random string). Required in production.
ORDER_LINK_SECRET=

# Live site address used to build the links in order emails, e.g. https://example.com
SITE_URL=

# Business address that receives each order
ORDER_EMAIL=

# Verified sender address for order emails (Resend)
ORDER_FROM_EMAIL=

# Secret Vercel Cron uses to call the daily photo cleanup (set in Vercel project settings)
CRON_SECRET=
